# Postgres connection string - Railway fills this in automatically if you use its Postgres plugin
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random long random string, used to sign login sessions. Generate any long random value.
SESSION_SECRET="change-me-to-a-long-random-string"

# The public URL of your deployed app (no trailing slash), used inside emails.
APP_URL="https://your-app.up.railway.app"

# Email that becomes the admin account on first seed run
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Я"

# SMTP settings to send magic-link / invite emails.
# Easiest options: Resend (smtp.resend.com), Gmail with an App Password, or any SMTP provider.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="your-smtp-password-or-api-key"
MAIL_FROM="Уборка <you@example.com>"
